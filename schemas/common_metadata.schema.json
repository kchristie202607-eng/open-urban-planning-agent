{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/common_metadata.schema.json",
  "title": "OUPAP Common Provenance Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "title", "source_type", "region", "authority", "date", "topic", "version", "confidence", "review_status"],
  "properties": {
    "document_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "source_type": { "type": "string", "enum": ["pdf", "internal_rule", "gis", "web", "field_survey", "project_document", "questionnaire", "public_method"] },
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["country", "province", "city", "district"],
      "properties": { "country": { "type": "string" }, "province": { "type": "string" }, "city": { "type": "string" }, "district": { "type": "string" } }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["organization", "level"],
      "properties": { "organization": { "type": "string" }, "level": { "type": "string", "enum": ["international", "national", "provincial", "city", "district", "community", "project", "other"] } }
    },
    "date": {
      "type": "object", "additionalProperties": false,
      "required": ["issued", "updated"],
      "properties": { "issued": { "type": ["string", "null"], "format": "date" }, "updated": { "type": ["string", "null"], "format": "date" } }
    },
    "topic": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "version": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "review_status": { "type": "string", "enum": ["pending_review", "reviewed", "superseded", "rejected"] }
  }
}
