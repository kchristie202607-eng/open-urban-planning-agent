{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/map_manifest.schema.json",
  "title": "规划分析图成果清单",
  "type": "object",
  "required": ["version", "project_id", "maps"],
  "properties": {
    "version": {"type": "string"},
    "project_id": {"type": "string"},
    "maps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "map_id", "figure_no", "title", "section", "map_type",
          "source_layers", "source_crs", "display_crs", "canvas",
          "viewport", "outputs", "qa"
        ],
        "properties": {
          "map_id": {"type": "string"},
          "figure_no": {"type": "string"},
          "title": {"type": "string"},
          "section": {"type": "string"},
          "map_type": {
            "enum": [
              "location", "scope", "land_use", "housing", "problem",
              "road_transport", "ecology", "potential", "other"
            ]
          },
          "source_layers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_crs": {"type": "string"},
          "display_crs": {"type": "string"},
          "canvas": {
            "type": "object",
            "required": ["width", "height", "unit"],
            "properties": {
              "width": {"type": "number", "exclusiveMinimum": 0},
              "height": {"type": "number", "exclusiveMinimum": 0},
              "unit": {"type": "string"}
            }
          },
          "viewport": {
            "type": "object",
            "required": ["min_x", "min_y", "max_x", "max_y"],
            "properties": {
              "min_x": {"type": "number"},
              "min_y": {"type": "number"},
              "max_x": {"type": "number"},
              "max_y": {"type": "number"}
            }
          },
          "content_policy": {"type": "string"},
          "georeferencing": {"type": "object"},
          "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "qa": {
            "type": "object",
            "required": ["crs_checked", "topology_checked", "aspect_ratio_checked"],
            "properties": {
              "crs_checked": {"const": true},
              "topology_checked": {"const": true},
              "aspect_ratio_checked": {"const": true}
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
