{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/knowledge_item.schema.json",
  "title": "城市更新知识条目",
  "type": "object",
  "required": [
    "item_id",
    "document_id",
    "knowledge_base",
    "rule_category",
    "evidence",
    "mandatory_level",
    "review_status"
  ],
  "properties": {
    "item_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "knowledge_base": {
      "enum": ["A", "B", "C"]
    },
    "project_type": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rule_category": {
      "enum": [
        "编制程序",
        "空间划定",
        "更新方式",
        "公共服务",
        "开发强度",
        "历史文化保护",
        "产业与运营",
        "资金与财务",
        "项目实施",
        "成果制图",
        "证据管理",
        "成果质检",
        "其他"
      ]
    },
    "indicator": {
      "type": ["string", "null"]
    },
    "operator": {
      "type": ["string", "null"]
    },
    "value": {
      "oneOf": [
        {"type": "number"},
        {"type": "string"},
        {"type": "null"},
        {
          "type": "array",
          "items": {"type": "string"}
        }
      ]
    },
    "unit": {
      "type": ["string", "null"]
    },
    "mandatory_level": {
      "enum": ["强制", "引导", "案例参考", "待判断"]
    },
    "applicable_conditions": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["source_file", "quotation"],
      "anyOf": [
        {"required": ["pdf_page"]},
        {"required": ["source_locator"]}
      ],
      "properties": {
        "source_file": {
          "type": "string"
        },
        "pdf_page": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "source_locator": {
          "type": ["string", "null"]
        },
        "source_type": {
          "enum": ["pdf", "internal_rule", "gis", "web", "field_survey", "project_document", "questionnaire"]
        },
        "quotation": {
          "type": "string"
        },
        "extraction_method": {
          "enum": ["text", "ocr", "structured"]
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "review_status": {
      "enum": ["待人工复核", "已复核", "已驳回"]
    },
    "review_notes": {
      "type": ["string", "null"]
    },
    "metadata": {
      "$ref": "./common_metadata.schema.json"
    }
  },
  "additionalProperties": false
}
