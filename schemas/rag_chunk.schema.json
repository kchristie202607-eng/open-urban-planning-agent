{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "城市更新 RAG 检索块",
  "type": "object",
  "required": [
    "chunk_id",
    "document_id",
    "knowledge_base",
    "source_file",
    "text"
  ],
  "anyOf": [
    {"required": ["pdf_page"]},
    {"required": ["source_locator"]}
  ],
  "properties": {
    "chunk_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "knowledge_base": {
      "enum": ["A", "B", "C"]
    },
    "source_file": {
      "type": "string"
    },
    "pdf_page": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "source_locator": {
      "type": ["string", "null"]
    },
    "source_type": {
      "enum": ["pdf", "internal_rule", "gis", "web", "field_survey"]
    },
    "text": {
      "type": "string"
    },
    "extraction_method": {
      "enum": ["text", "ocr", "structured"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "document_status": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
